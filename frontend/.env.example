# ═══════════════════════════════════════════════════════════════════════════
# Appzeto / BigMol Frontend (Vite) — environment variables
# Only VITE_* variables are exposed to the browser. Never put secrets here.
# Restart `npm run dev` after editing.
# ═══════════════════════════════════════════════════════════════════════════

# ─── API ────────────────────────────────────────────────────────────────────
# Backend API base (include /api). Dev proxy in vite.config.js also forwards /api -> :5000
VITE_API_BASE_URL=http://localhost:5000/api
# Backend origin WITHOUT /api — prefixes relative avatar paths (delivery profile, order tracking)
VITE_API_URL=http://localhost:5000
# Prefix for relative image paths (leave empty if images are absolute Cloudinary URLs)
VITE_IMAGE_BASE_URL=

# ─── Razorpay (public key id only — NOT the secret) ─────────────────────────
VITE_RAZORPAY_KEY_ID=

# ─── Firebase web app config (Firebase console → Project settings → Your apps) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate key pair (Cloud Messaging tab)
VITE_FIREBASE_VAPID_KEY=
