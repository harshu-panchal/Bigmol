# ═══════════════════════════════════════════════════════════════════════════
# Appzeto / BigMol Backend — environment variables
# Fill in the values marked  <-- REQUIRED  before starting the server.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Frontend origin allowed by CORS (vite dev server runs on 3000)
CLIENT_URL=http://localhost:3000

# ─── MongoDB ────────────────────────────────────────────────────────────────
# <-- REQUIRED  e.g. mongodb://localhost:27017/bigmol  or  mongodb+srv://user:pass@cluster/db
MONGO_URI=
# Optional tuning (defaults: 20 / 5 / 15000)
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5
MONGO_CONNECT_TIMEOUT_MS=15000
# Use public DNS (8.8.8.8, 1.1.1.1) for Atlas SRV lookups. Auto-on for mongodb+srv://.
# Set true/false to force.
FORCE_PUBLIC_DNS=

# ─── JWT ────────────────────────────────────────────────────────────────────
# <-- REQUIRED  use long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
# JWT_SECRET is also used to sign/hash delivery OTPs and verify app signatures.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary (image uploads) ─────────────────────────────────────────────
# <-- REQUIRED
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Firebase Admin / FCM push notifications ────────────────────────────────
# <-- REQUIRED  The full service-account JSON, minified onto ONE line.
# Keep private_key newlines as literal \n.
FIREBASE_SERVICE_ACCOUNT=

# ─── Razorpay (payments) ────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured on the Razorpay dashboard webhook
RAZORPAY_WEBHOOK_SECRET=

# ─── Email (SMTP) — used for OTP / notification emails ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_NAME=BigMol Store
FROM_EMAIL=

# ─── Dev-only toggles ───────────────────────────────────────────────────────
# Enables GET /api/delivery/orders/:id/debug-otp (ignored when NODE_ENV=production)
ENABLE_DEBUG_ROUTES=false

# ─── Optional: scripts/createTestUser.js ────────────────────────────────────
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_NAME=
TEST_USER_PHONE=
